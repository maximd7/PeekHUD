<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the NotifyIcon / ContextMenuStrip tray integration -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PeekHUD</AssemblyName>
    <RootNamespace>PeekHUD</RootNamespace>
    <Product>PeekHUD</Product>
    <Title>PeekHUD</Title>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>PeekIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="PeekIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- CPU / GPU / memory sensors -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <!-- ETW consumer used to count DXGI Present calls (FPS) -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
  </ItemGroup>

</Project>

